                  "var body = pm.response.json();",
                  "pm.test('every returned transaction is an EXPENSE', function () {",
                  "  body.content.forEach(function (t) { pm.expect(t.type).to.eql('EXPENSE'); });",
                  "});"
                ]
              }
            }
