    {
      "name": "2. Transactions",
      "item": [
        {
          "name": "Create EXPENSE (201, saves id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/transactions", "host": ["{{base_url}}"], "path": ["api", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"QA Supermarket\",\n  \"amount\": 150.00,\n  \"type\": \"EXPENSE\",\n  \"date\": \"{{pf_date}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"budgetGroup\": \"ESSENTIAL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('type is EXPENSE and amount matches', function () {",
                  "  pm.expect(body.type).to.eql('EXPENSE');",
                  "  pm.expect(Number(body.amount)).to.eql(150);",
                  "});",
                  "pm.test('budgetGroup persisted, no incomeType', function () {",
                  "  pm.expect(body.budgetGroup).to.eql('ESSENTIAL');",
                  "  pm.expect(body.incomeType == null).to.be.true;",
                  "});",
                  "pm.collectionVariables.set('expenseTxId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create INCOME (201, saves id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/transactions", "host": ["{{base_url}}"], "path": ["api", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"QA Salary\",\n  \"amount\": 5000.00,\n  \"type\": \"INCOME\",\n  \"date\": \"{{pf_date}}\",\n  \"incomeType\": \"INCOME\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('type is INCOME with incomeType INCOME', function () {",
                  "  pm.expect(body.type).to.eql('INCOME');",
                  "  pm.expect(body.incomeType).to.eql('INCOME');",
                  "});",
                  "pm.collectionVariables.set('incomeTxId', body.id);"
                ]
              }
            }
          ]
        },
