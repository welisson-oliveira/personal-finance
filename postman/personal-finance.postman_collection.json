{
  "info": {
    "name": "Personal Finance API — Black-box tests",
    "_postman_id": "0a4c0b2e-9f3a-4d5c-9c2e-personalfinance",
    "description": "End-to-end black-box tests for the Personal Finance REST API (Spring Boot).\n\nRun the whole collection top-to-bottom (Collection Runner or `newman`). It registers a fresh user each run, captures the JWT, and exercises every domain with positive and negative assertions.\n\nRequires a running backend (default http://localhost:8080). Set `base_url` via the bundled environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{pf_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request. Seed run-scoped variables exactly once.",
          "if (!pm.collectionVariables.get('pf_email')) {",
          "  pm.collectionVariables.set('pf_email', 'qa_' + Date.now() + '@example.com');",
          "  pm.collectionVariables.set('pf_password', 'Password123!');",
          "  pm.collectionVariables.set('pf_name', 'QA Runner');",
          "}",
          "if (!pm.collectionVariables.get('pf_year')) {",
          "  var now = new Date();",
          "  var y = now.getFullYear();",
          "  var m = now.getMonth() + 1;",
          "  var mm = String(m).padStart(2, '0');",
          "  pm.collectionVariables.set('pf_year', y);",
          "  pm.collectionVariables.set('pf_month', m);",
          "  pm.collectionVariables.set('pf_month_str', y + '-' + mm);",
          "  pm.collectionVariables.set('pf_date', y + '-' + mm + '-15');",
          "}",
          "if (!pm.collectionVariables.get('base_url')) {",
          "  pm.collectionVariables.set('base_url', 'http://localhost:8080');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "pf_token", "value": "" },
    { "key": "pf_user_id", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "globalCategoryId", "value": "" },
    { "key": "expenseTxId", "value": "" },
    { "key": "incomeTxId", "value": "" },
    { "key": "goalId", "value": "" },
    { "key": "personId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth & Profile",
      "item": [
        {
          "name": "Register (201, saves token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{pf_name}}\",\n  \"email\": \"{{pf_email}}\",\n  \"password\": \"{{pf_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('returns a JWT token', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });",
                  "pm.test('returns the user with matching email', function () {",
                  "  pm.expect(body.user).to.be.an('object');",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('pf_email'));",
                  "  pm.expect(body.user.id).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('pf_token', body.token);",
                  "pm.collectionVariables.set('pf_user_id', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"{{pf_email}}\",\n  \"password\": \"{{pf_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects duplicate email with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register invalid (short password) (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Short\",\n  \"email\": \"short_{{$timestamp}}@example.com\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects short password with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (200, refreshes token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pf_email}}\",\n  \"password\": \"{{pf_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
