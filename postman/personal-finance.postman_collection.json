    {
      "name": "3. Dashboard",
      "item": [
        {
          "name": "GET /dashboard/monthly (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard/monthly?year={{pf_year}}&month={{pf_month}}",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "monthly"],
              "query": [
                { "key": "year", "value": "{{pf_year}}" },
                { "key": "month", "value": "{{pf_month}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('echoes requested year/month', function () {",
                  "  pm.expect(body.year).to.eql(Number(pm.collectionVariables.get('pf_year')));",
                  "  pm.expect(body.month).to.eql(Number(pm.collectionVariables.get('pf_month')));",
                  "});",
                  "pm.test('exposes 50/30/20 aggregates', function () {",
                  "  ['receitaBruta','totalDespesas','percentualEssenciais','rendaBase','saldo'].forEach(function (k) {",
                  "    pm.expect(body).to.have.property(k);",
                  "  });",
                  "});",
                  "pm.test('destaques block present', function () { pm.expect(body.destaques).to.be.an('object'); });"
                ]
              }
            }
          ]
        }
      ]
    },
