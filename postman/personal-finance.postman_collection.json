            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/transactions", "host": ["{{base_url}}"], "path": ["api", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Zero\",\n  \"amount\": 0,\n  \"type\": \"EXPENSE\",\n  \"date\": \"{{pf_date}}\"\n}"
