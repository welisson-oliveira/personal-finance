              "raw": "{{base_url}}/api/transactions?month={{pf_month_str}}&type=EXPENSE",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "month", "value": "{{pf_month_str}}" },
                { "key": "type", "value": "EXPENSE" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
