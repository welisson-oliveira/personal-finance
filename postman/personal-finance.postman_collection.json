                  "pm.test('amount below minimum rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List transactions for month (200, paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/transactions?month={{pf_month_str}}",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"],
              "query": [{ "key": "month", "value": "{{pf_month_str}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('is a Spring Page with content array', function () { pm.expect(body.content).to.be.an('array'); });",
                  "pm.test('our expense is listed', function () {",
                  "  var ids = body.content.map(function (t) { return t.id; });",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('expenseTxId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List filtered by type=EXPENSE (200)",
          "request": {
            "method": "GET",
            "header": [],
