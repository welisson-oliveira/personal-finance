                  "var body = pm.response.json();",
                  "pm.test('returns a JWT token', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('pf_token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pf_email}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects bad credentials (401 or 403)', function () { pm.expect(pm.response.code).to.be.oneOf([401, 403]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/me without token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api", "users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthenticated request is rejected (401 or 403)', function () { pm.expect(pm.response.code).to.be.oneOf([401, 403]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/me with token (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api", "users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('email matches the registered user', function () { pm.expect(body.email).to.eql(pm.collectionVariables.get('pf_email')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /users/me — set salary (200)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api", "users", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"monthlyNetIncome\": 5000.00\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('monthlyNetIncome is persisted', function () { pm.expect(Number(body.monthlyNetIncome)).to.eql(5000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /users/me — negative salary (400)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api", "users", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"monthlyNetIncome\": -1\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('negative salary is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Categories",
      "item": [
        {
          "name": "List categories (200, has globals)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories", "host": ["{{base_url}}"], "path": ["api", "categories"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('returns a non-empty array (seeded global categories)', function () {",
                  "  pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "});",
                  "var globals = body.filter(function (c) { return c.global === true; });",
                  "pm.test('at least one global category exists', function () { pm.expect(globals.length).to.be.above(0); });",
                  "if (globals.length) { pm.collectionVariables.set('globalCategoryId', globals[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category (201, saves id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/categories", "host": ["{{base_url}}"], "path": ["api", "categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"QA Category {{$timestamp}}\",\n  \"icon\": \"shopping_cart\",\n  \"color\": \"#3f51b5\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('created as a user (non-global) category', function () { pm.expect(body.global).to.eql(false); });",
                  "pm.test('has an id', function () { pm.expect(body.id).to.be.a('string'); });",
                  "pm.collectionVariables.set('categoryId', body.id);"
                ]
              }
            }
          ]
        },
